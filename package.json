{
    "name": "dart-tool",
    "version": "1.0.0",
    "description": "A Tool for playing Darts",
    "license": "MIT",
    "author": "itCarl",
    "type": "module",
    "main": "data/app.js",
    "scripts": {
        "clean": "rimraf dist",
        "build:js": "esbuild data/app.js --bundle --sourcemap --minify --format=esm --outfile=dist/app.js",
        "build:assets": "cpy \"data/**/*\" dist --cwd=. --parents --filter=\"**/*.{html,css,svg,png,json}\"",
        "build": "npm run clean && npm run build:assets && npm run build:js",

        "watch": "esbuild data/app.js --bundle --sourcemap --format=esm --outfile=dist/app.js --watch",

        "start": "node data/server.js",
        "start:dev": "node scripts/dev-server.js",
        "start:prod": "NODE_ENV=production node data/server.js"
    },
    "dependencies": {
        "@dartbot/dartboard": "^0.4.0",
        "nodemon": "^3.1.11"
    },
    "devDependencies": {
        "cpy-cli": "^6.0.0",
        "esbuild": "^0.27.2",
        "rimraf": "^6.1.2",
        "tslib": "^2.8.1"
    }
}
